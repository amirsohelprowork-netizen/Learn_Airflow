# Sample AWS S3 Remote Backend Configuration for Production
# Only for a SEPARATE production IaC root declaring backend "s3" {}.
# The current terraform/ root declares a local backend: these options do not apply.
# See docs/PRODUCTION.md; do not reconfigure the local lab with this file.

bucket         = "company-airflow-tfstate-prod"
key            = "airflow/prod/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "terraform-locks"
encrypt        = true
